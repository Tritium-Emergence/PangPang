{
  "cloud_url": "https://REPLACE_WITH_CLOUD_ORIGIN",
  "host_id": "linux-gpu",
  "credential_env": "PANGPANG_DEVICE_TOKEN",
  "allow_file_receive": false,
  "hosts": [
    {
      "id": "linux-gpu",
      "os": "Linux",
      "transport": "local",
      "allowed_roots": [
        "/REPLACE_WITH_AUTHORIZED_WORKSPACE"
      ]
    }
  ],
  "installations": [
    {
      "id": "claude-code-linux-gpu",
      "host_id": "linux-gpu",
      "adapter": "claude-code",
      "enabled": false,
      "argv": [
        "claude",
        "-p"
      ],
      "probe_argv": [
        "claude",
        "--version"
      ],
      "prompt_mode": "stdin",
      "cwd": "/REPLACE_WITH_AUTHORIZED_WORKSPACE",
      "risk": "write",
      "permission_verified": false,
      "resource_keys": [],
      "timeout_s": 3600
    },
    {
      "id": "codex-linux-gpu",
      "host_id": "linux-gpu",
      "adapter": "codex",
      "enabled": false,
      "argv": [
        "codex",
        "exec",
        "-"
      ],
      "probe_argv": [
        "codex",
        "--version"
      ],
      "prompt_mode": "stdin",
      "cwd": "/REPLACE_WITH_AUTHORIZED_WORKSPACE",
      "risk": "write",
      "permission_verified": false,
      "resource_keys": [],
      "timeout_s": 3600
    },
    {
      "id": "qwen-claude-linux-gpu",
      "host_id": "linux-gpu",
      "adapter": "qwen-claude",
      "enabled": false,
      "argv": [
        "/REPLACE_WITH_VERIFIED_QWEN_CLAUDE_ENTRY"
      ],
      "probe_argv": [
        "/REPLACE_WITH_VERIFIED_QWEN_CLAUDE_ENTRY",
        "--version"
      ],
      "prompt_mode": "stdin",
      "cwd": "/REPLACE_WITH_AUTHORIZED_WORKSPACE",
      "risk": "write",
      "permission_verified": false,
      "resource_keys": [
        "qwen-shared"
      ],
      "timeout_s": 3600
    }
  ],
  "resources": [
    {
      "key": "qwen-shared",
      "acquire_argv": [
        "/REPLACE_WITH_VERIFIED_SLOT_ACQUIRE"
      ],
      "release_argv": [
        "/REPLACE_WITH_VERIFIED_SLOT_RELEASE"
      ]
    }
  ]
}
