{
  "default_model": "default",
  "turn_budget": 8,
  "delegation_budget": 6,
  "semantic_gate": {
    "mode": "off",
    "continuation_routing": true
  },
  "models": [
    {
      "id": "default",
      "endpoint": "https://REPLACE_WITH_LLM_ENDPOINT/v1",
      "model": "REPLACE_WITH_YOUR_MODEL_ID",
      "credential_env": "PANGPANG_LLM_KEY",
      "context_budget": 32000,
      "output_tokens": 8192,
      "timeout_s": 120,
      "generation_settings": {},
      "resource_keys": []
    }
  ],
  "hosts": [
    {
      "id": "local",
      "os": "Linux",
      "transport": "local",
      "allowed_roots": [
        "/REPLACE_WITH_AUTHORIZED_WORKSPACE"
      ]
    }
  ],
  "installations": [
    {
      "id": "codex-local",
      "host_id": "local",
      "adapter": "codex",
      "enabled": false,
      "argv": [
        "DEVICE_LOCAL_COMMAND"
      ],
      "probe_argv": [
        "DEVICE_LOCAL_COMMAND"
      ],
      "prompt_mode": "stdin",
      "cwd": "DEVICE_LOCAL_WORKSPACE",
      "risk": "write",
      "permission_verified": false,
      "resource_keys": [],
      "timeout_s": 3600
    }
  ],
  "resources": []
}
