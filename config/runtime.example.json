{
  "default_model": "default",
  "turn_budget": 8,
  "delegation_budget": 6,
  "semantic_gate": {
    "mode": "off",
    "continuation_routing": true,
    "model": "jev-latest",
    "timeout_s": 2.0,
    "continuation_switch_threshold": 0.75,
    "correction_threshold": 0.85,
    "continuation_breaker_failures": 3,
    "continuation_breaker_cooldown_s": 30,
    "max_state_bytes": 65536,
    "tools": [
      "link_work",
      "cancel_dependency",
      "send_bot_message",
      "delegate",
      "submit_task"
    ]
  },
  "models": [
    {
      "id": "default",
