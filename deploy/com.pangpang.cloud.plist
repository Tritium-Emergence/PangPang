<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.pangpang.cloud</string>
<key>ProgramArguments</key><array>
<string>/usr/bin/env</string><string>python3</string><string>-m</string><string>pangpang.cli</string>
<string>cloud</string><string>--data</string>
<string>/Users/REPLACE/Library/Application Support/pangpang</string>
</array>
<key>WorkingDirectory</key><string>/Users/REPLACE/Library/Application Support/pangpang</string>
<!-- Set PANGPANG_TOKEN in the launchd environment, not in this file. --origin disables POSIX L0 inference. -->
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
</dict></plist>
