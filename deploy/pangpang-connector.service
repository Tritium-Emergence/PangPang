[Unit]
Description=PangPang outbound host connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Pair this machine interactively once before enabling the service.
# Pairing persists cloud URL, device token and workspace policy in --data.
WorkingDirectory=/REPLACE_WITH_REPO
ExecStart=/usr/bin/python3 -m pangpang.connector --data /REPLACE_WITH_PRIVATE_DATA
Restart=on-failure
RestartSec=5
# Detached task supervisors survive connector restarts and keep their receipts.
KillMode=process
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
